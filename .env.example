# Postgres connection string (Neon/Vercel sets these automatically in production).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection, used by Prisma for migrations / db push.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"
APP_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
